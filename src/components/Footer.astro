---
interface Props {
  lang: string;
  t: any;
}
const { lang, t } = Astro.props;
const year = new Date().getFullYear();
const copyright = t.footer.copyright.replace('{year}', String(year));

const navLinks = [
  { key: 'home', href: `/${lang}/` },
  { key: 'activities', href: `/${lang}/activities` },
  { key: 'calendar', href: `/${lang}/calendar` },
  { key: 'sponsors', href: `/${lang}/sponsors` },
  { key: 'reviews', href: `/${lang}/reviews` },
  { key: 'contact', href: `/${lang}/contact` },
  { key: 'apps', href: `/${lang}/apps` },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={`/${lang}/`} class="footer-logo-link">
          <img src="/logo.png" alt={t.site.name} height="36" class="footer-logo" />
        </a>
        <p class="footer-tagline">{t.footer.tagline}</p>
        <div class="footer-social">
          <a href="https://www.instagram.com/activetimisoara/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            Instagram
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>{t.footer.nav_title}</h4>
        <ul>
          {navLinks.map(link => (
            <li><a href={link.href}>{t.nav[link.key]}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t.footer.contact_title}</h4>
        <ul>
          <li>
            <a href={`mailto:${t.footer.email}`}>{t.footer.email}</a>
          </li>
          <li>Timișoara, România</li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t.footer.legal_title}</h4>
        <ul>
          <li><a href="#">{t.footer.privacy}</a></li>
          <li><a href="#">{t.footer.terms}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>{copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: rgba(255, 255, 255, 0.75);
    padding-top: 4rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo-link {
    display: inline-block;
  }

  .footer-logo {
    height: 36px;
    width: auto;
    filter: brightness(1.15);
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .social-link:hover {
    color: var(--brand);
  }

  .footer-col h4 {
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-col ul li,
  .footer-col ul li a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.65);
    transition: color 0.15s ease;
  }

  .footer-col ul li a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    padding: 1.5rem 0;
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.4);
  }
</style>
