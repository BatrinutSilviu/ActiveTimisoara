---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getStaticLangPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params;
const t = getTranslations(lang);
---

<Layout
  title={t.sponsors.title}
  lang={lang}
  page="sponsors"
  t={t}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <h1>{t.sponsors.title}</h1>
      <p>{t.sponsors.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sponsors-grid">
        <a class="sponsor-card card" href="https://liftbox.ro/" target="_blank" rel="noopener noreferrer">
          <div class="sponsor-logo">
            <img src="/sponsors/liftbox.png" alt="L.I.F.T. BOX by Health Studio" />
          </div>
          <div class="sponsor-info">
            <h2>L.I.F.T. BOX</h2>
            <p>by Health Studio</p>
          </div>
        </a>
        <a class="sponsor-card card" href="https://www.instagram.com/motiv.specialty.coffee/" target="_blank" rel="noopener noreferrer">
          <div class="sponsor-logo">
            <img src="/sponsors/motiv.jpeg" alt="Motiv Specialty Coffee" />
          </div>
          <div class="sponsor-info">
            <h2>Motiv</h2>
            <p>Specialty Coffee</p>
          </div>
        </a>
        <a class="sponsor-card card" href="https://www.activearena.ro/" target="_blank" rel="noopener noreferrer">
          <div class="sponsor-logo sponsor-logo--contain">
            <img src="/sponsors/active-arena.png" alt="Active Arena" />
          </div>
          <div class="sponsor-info">
            <h2>Active Arena</h2>
            <p>Sport Complex</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="become-sponsor">
    <div class="container become-inner">
      <div class="become-text">
        <h2>{t.sponsors.become_title}</h2>
        <p>{t.sponsors.become_subtitle}</p>
      </div>
      <a href={`/${lang}/contact`} class="btn">{t.sponsors.become_button}</a>
    </div>
  </section>
</Layout>

<style>

  .sponsors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
  }

  .sponsor-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 2.5rem 2rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .sponsor-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

.sponsor-logo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
  }

  .sponsor-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sponsor-logo--contain img {
    object-fit: contain;
    padding: 14px;
  }

  .sponsor-info h2 {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
  }

  .sponsor-info p {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .become-sponsor {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 4rem 0;
  }

  .become-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .become-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .become-text h2 {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .become-text p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    max-width: 500px;
  }

  @media (max-width: 640px) {
    .become-sponsor {
      padding: 2.5rem 0;
    }
    .become-text h2 {
      font-size: 1.375rem;
    }
    .sponsor-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
