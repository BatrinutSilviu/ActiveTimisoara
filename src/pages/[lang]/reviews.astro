---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getStaticLangPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params;
const t = getTranslations(lang);
---

<Layout
  title={t.reviews.title}
  lang={lang}
  page="reviews"
  t={t}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <h1>{t.reviews.title}</h1>
      <p>{t.reviews.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="empty-state card">
        <div class="empty-icon" aria-hidden="true">💬</div>
        <h2>
          {lang === 'ro'
            ? 'Încă nu avem recenzii'
            : 'No reviews yet'}
        </h2>
        <p>
          {lang === 'ro'
            ? 'Comunitatea noastră tocmai a pornit la drum. Dacă ai participat la una dintre activitățile noastre, ne-ar face plăcere să aflăm cum a fost — scrie-ne!'
            : 'Our community is just getting started. If you\'ve joined one of our activities, we\'d love to hear how it went — drop us a message!'}
        </p>
        <a href={`/${lang}/contact`} class="btn">
          {lang === 'ro' ? 'Trimite-ne feedback' : 'Send us feedback'}
        </a>
      </div>
    </div>
  </section>

  <section class="cta-reviews">
    <div class="container cta-inner">
      <h2>{lang === 'ro' ? 'Alătură-te comunității' : 'Join the community'}</h2>
      <p>{lang === 'ro' ? 'Și tu poți face parte din povestea noastră.' : 'You too can be part of our story.'}</p>
      <a href={`/${lang}/contact`} class="btn">{lang === 'ro' ? 'Contactează-ne' : 'Contact us'}</a>
    </div>
  </section>
</Layout>

<style>

  .empty-state {
    max-width: 560px;
    margin: 0 auto;
    padding: 3.5rem 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .empty-icon {
    font-size: 3rem;
    line-height: 1;
  }

  .empty-state h2 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .empty-state p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .cta-reviews {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 4rem 0;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-inner h2 {
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .cta-inner p {
    font-size: 1rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .empty-state {
      padding: 2rem 1.25rem;
    }
  }
</style>
