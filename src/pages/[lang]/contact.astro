---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getStaticLangPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params;
const t = getTranslations(lang);
---

<Layout
  title={t.contact.title}
  lang={lang}
  page="contact"
  t={t}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <h1>{t.contact.title}</h1>
      <p>{t.contact.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-cards">

        <div class="contact-card card contact-card--primary">
          <div class="card-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
          </div>
          <div class="card-body">
            <h2>{lang === 'ro' ? 'Grupuri WhatsApp' : 'WhatsApp Groups'}</h2>
            <p>
              {lang === 'ro'
                ? 'Cel mai rapid mod de a te alătura este prin grupul de WhatsApp al sportului tău preferat. Găsești linkul pe pagina fiecărei activități.'
                : 'The fastest way to join is through the WhatsApp group for your favourite sport. Find the link on each activity\'s page.'}
            </p>
            <a href="https://chat.whatsapp.com/CNwXFKZizaE7Ekz0MHb1Qc" target="_blank" rel="noopener noreferrer" class="btn">
              {lang === 'ro' ? 'Alătură-te grupului →' : 'Join the group →'}
            </a>
          </div>
        </div>

        <div class="contact-card card">
          <div class="card-icon card-icon--email" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="card-body">
            <h2>{lang === 'ro' ? 'Email' : 'Email'}</h2>
            <p>
              {lang === 'ro'
                ? 'Pentru orice altceva — parteneriate, întrebări generale sau dacă vrei să aduci un sport nou în comunitate.'
                : 'For anything else — partnerships, general questions, or if you want to bring a new sport to the community.'}
            </p>
            <button id="copy-email" class="btn btn-outline-dark" data-email="active.timisoara@gmail.com" data-label-copied={lang === 'ro' ? 'Copiat!' : 'Copied!'}>
              active.timisoara@gmail.com
            </button>
          </div>
        </div>

        <div class="contact-card card">
          <div class="card-icon card-icon--instagram" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </div>
          <div class="card-body">
            <h2>Instagram</h2>
            <p>
              {lang === 'ro'
                ? 'Urmărește-ne pentru poze, anunțuri și momente din comunitate.'
                : 'Follow us for photos, announcements and community moments.'}
            </p>
            <a href="https://www.instagram.com/activetimisoara/" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark">
              @activetimisoara
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email!;
      const labelCopied = btn.dataset.labelCopied!;
      await navigator.clipboard.writeText(email);
      const original = btn.textContent!;
      btn.textContent = labelCopied;
      btn.disabled = true;
      setTimeout(() => {
        btn.textContent = original;
        btn.disabled = false;
      }, 2000);
    });
  }
</script>

<style>

  .contact-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .contact-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
  }

  .contact-card:nth-child(2) { order: 3; }
  .contact-card:nth-child(3) { order: 2; }

  .contact-card .card-body {
    flex: 1;
  }

  .contact-card .card-body p {
    flex: 1;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #dcfce7;
    color: #16a34a;
  }

  .contact-card--primary .card-icon {
    background: #dcfce7;
    color: #16a34a;
  }

  .card-icon--email {
    background: #dbeafe;
    color: #2563eb;
  }

  .card-icon--instagram {
    background: #fce7f3;
    color: #db2777;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .card-body h2 {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .card-body p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 0.375rem;
  }

  @media (max-width: 640px) {
    .contact-card {
      padding: 1.25rem;
    }
    .card-body .btn,
    .card-body .btn-outline-dark {
      width: 100%;
      justify-content: center;
    }
  }
</style>
