---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getStaticLangPaths } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params;
const t = getTranslations(lang);
---

<Layout
  title={t.apps.title}
  lang={lang}
  page="apps"
  t={t}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <h1>{t.apps.title}</h1>
      <p>{t.apps.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="apps-grid">
        <div class="app-card app-card--active card">
          <div class="app-icon app-icon--padel">🎾</div>
          <div class="app-content">
            <div class="app-status app-status--live">
              <span class="status-dot"></span>
              {lang === 'ro' ? 'Disponibil acum' : 'Available now'}
            </div>
            <h2>{t.apps.padel_name}</h2>
            <p>{t.apps.padel_desc}</p>
            <div class="app-features">
              <span class="feature-chip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                {lang === 'ro' ? 'Găsire parteneri' : 'Find partners'}
              </span>
              <span class="feature-chip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <line x1="18" y1="20" x2="18" y2="10"/>
                  <line x1="12" y1="20" x2="12" y2="4"/>
                  <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                {lang === 'ro' ? 'Clasament' : 'Leaderboard'}
              </span>
            </div>
            <a
              href="https://padel.activetimisoara.ro"
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
            >
              {t.apps.padel_button}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="app-card app-card--coming-soon card">
          <div class="app-icon app-icon--hiking">🥾</div>
          <div class="app-content">
            <div class="app-status app-status--soon">
              {t.apps.coming_soon}
            </div>
            <h2>{t.apps.hiking_name}</h2>
            <p>{t.apps.hiking_desc}</p>
            <div class="app-features coming-soon-features">
              <span class="feature-chip feature-chip--muted">
                {lang === 'ro' ? 'Trasee' : 'Trails'}
              </span>
              <span class="feature-chip feature-chip--muted">
                {lang === 'ro' ? 'Planificare' : 'Planning'}
              </span>
              <span class="feature-chip feature-chip--muted">
                {lang === 'ro' ? 'Grup' : 'Group'}
              </span>
            </div>
            <button class="btn btn-disabled" disabled aria-disabled="true">
              {t.apps.coming_soon}
            </button>
          </div>
        </div>
      </div>

      <div class="suggest-box">
        <div class="suggest-icon" aria-hidden="true">💡</div>
        <div class="suggest-text">
          <h3>{lang === 'ro' ? 'Ai o idee pentru o aplicație nouă?' : 'Have an idea for a new app?'}</h3>
          <p>{lang === 'ro' ? 'Suntem mereu deschiși la sugestii din comunitate.' : 'We are always open to suggestions from the community.'}</p>
        </div>
        <a href={`/${lang}/contact`} class="btn-outline-dark">
          {lang === 'ro' ? 'Spune-ne' : 'Tell us'}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>

  .apps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .app-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .app-card--coming-soon {
    opacity: 0.7;
  }

  .app-icon {
    font-size: 3.5rem;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: saturate(0.6);
  }

  .app-icon--padel {
    background: #fff7ed;
    filter: none;
  }

  .app-icon--hiking {
    background: #d1fae5;
  }

  .app-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
  }

  .app-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .app-status--live {
    color: #16a34a;
  }

  .app-status--soon {
    color: var(--text-muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    animation: pulse-dot 2s ease infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .app-content h2 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .app-content p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
    flex: 1;
  }

  .app-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.625rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text);
  }

  .feature-chip--muted {
    color: var(--text-muted);
    opacity: 0.7;
  }

  .btn-disabled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    background: var(--border);
    color: var(--text-muted);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: not-allowed;
    border: 2px solid transparent;
    width: 100%;
  }

  .suggest-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .suggest-box {
      flex-direction: row;
      align-items: center;
    }
  }

  .suggest-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .suggest-text {
    flex: 1;
  }

  .suggest-text h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .suggest-text p {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
